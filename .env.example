# Backend base URL. Leave EMPTY for local development: /api requests are proxied
# by Vite to http://localhost:8000. Set to the deployed backend URL for production builds.
VITE_API_URL=

# Mock API (MSW) for the Vercel demo. Implemented in Milestone 7.
VITE_ENABLE_MOCKS=false

VITE_APP_NAME=CivicOS
VITE_APP_VERSION=0.1.0
